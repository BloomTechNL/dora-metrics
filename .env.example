# Copy this file to .env and fill in the values below, then run ./fetch_data.sh.
# .env is gitignored, so it's safe to put real credentials in it.

# Trello API key. Get one (and generate the token below on the same page) at:
# https://trello.com/app-key
TRELLO_API_KEY=

# Trello API token. On the https://trello.com/app-key page, click the "Token"
# link, authorize, and the resulting page shows the token.
TRELLO_TOKEN=

# Trello board id — the segment after /b/ in the board's URL, e.g.
# https://trello.com/b/WEJ9CX5t/some-board-name -> WEJ9CX5t
TRELLO_BOARD_ID=

# Local path to the git checkout to analyze. Must have a "main" branch and a
# GitHub "origin" remote (used to look up GitHub Actions runs for lead time).
GIT_REPO_PATH=

# GitHub personal access token with "actions:read" on that repo. Create one at:
# https://github.com/settings/tokens
GITHUB_TOKEN=
